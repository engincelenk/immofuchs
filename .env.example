# Kopieren nach ".env" (nicht eingecheckt). URL des Assistant-Workers
# (siehe worker/README.md fuer lokales Setup und Deploy).
VITE_ASSISTANT_URL=http://localhost:8787/api/assistant

# ═══ Kommerzialisierung (Spec 4.6, S3-5) ═══
# Paddle.js wird erst beim Erreichen der Plan-Auswahl dynamisch nachgeladen
# (src/utils/paddleLoader.js) - Client-Token aus dem Paddle-Dashboard
# (Developer Tools > Authentication), siehe docs/kommerzialisierung-setup.md.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENV=sandbox

# ═══ Bot-Schutz der Registrierung (Preispolitik 2026-08-20) ═══
# Oeffentlicher Site-Key des Turnstile-Widgets. Ohne ihn rendert das Feld
# nicht und der Worker laesst durch (warnt aber im Log) - lokal also optional.
# Das zugehoerige Secret liegt ausschliesslich im Wrangler-Secret-Store
# (wrangler secret put TURNSTILE_SECRET).
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEW18bBEyl_o5nTS
