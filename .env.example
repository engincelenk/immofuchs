# Kopieren nach ".env" (nicht eingecheckt). URL des Assistant-Workers
# (siehe worker/README.md fuer lokales Setup und Deploy).
VITE_ASSISTANT_URL=http://localhost:8787/api/assistant

# ═══ Kommerzialisierung (Spec 4.6, S3-5, seit 2026-08-26 auf Stripe
# umgestellt, siehe docs/plans/2026-08-26-paddle-zu-stripe-migration-spec.md) ═══
# Stripe.js wird erst beim Erreichen der Plan-Auswahl dynamisch nachgeladen
# (src/utils/stripeLoader.js) - Publishable Key aus dem Stripe-Dashboard
# (Entwickler > API-Schlüssel), unbedenklich im Klartext (laeuft im Browser).
VITE_STRIPE_PUBLISHABLE_KEY=

# ═══ Native In-App-Kaeufe (RevenueCat, siehe docs/app-store-google-play-setup.md
# Teil C) ═══ Oeffentliche RevenueCat-SDK-Keys, ein Key pro Plattform (RevenueCat-
# Dashboard > Projekt > API Keys). Nur wirksam innerhalb der Capacitor-App
# (Capacitor.isNativePlatform()) - im Browser folgenlos.
VITE_REVENUECAT_API_KEY_IOS=
VITE_REVENUECAT_API_KEY_ANDROID=

# ═══ Bot-Schutz der Registrierung (Preispolitik 2026-08-20) ═══
# Oeffentlicher Site-Key des Turnstile-Widgets. Ohne ihn rendert das Feld
# nicht und der Worker laesst durch (warnt aber im Log) - lokal also optional.
# Das zugehoerige Secret liegt ausschliesslich im Wrangler-Secret-Store
# (wrangler secret put TURNSTILE_SECRET).
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEW18bBEyl_o5nTS
