# Fastlane match - verschluesselte Zertifikate/Profile in einem separaten
# privaten Git-Repo (siehe docs/app-store-google-play-setup.md A10.5). Repo-
# URL und Passphrase kommen ausschliesslich als GitHub Secrets, nie im Code.
#
# MATCH_GIT_URL muss den Zugriffs-Token direkt eingebettet enthalten
# (https://<user>:<token>@github.com/<user>/<repo>), NICHT nur die reine
# Repo-URL + separates MATCH_GIT_BASIC_AUTHORIZATION-Secret - Live-Befund
# 2026-09-04: der separate Header-Mechanismus griff im CI-Lauf nicht
# ("could not read Username for 'https://github.com': terminal prompts
# disabled"), obwohl das Secret gesetzt war. Eingebetteter Token im
# git_url-Wert selbst ist der zuverlaessigere Weg.
git_url(ENV["MATCH_GIT_URL"])
storage_mode("git")
type("appstore")
app_identifier(["info.immofuchs.app"])
